# 站点地址（用于营销页等外链跳转）
VITE_SITE_URL=http://localhost:5173

# API 基础路径（后端地址）
VITE_API_BASE_URL=http://localhost:8080

# 阿里云验证码 2.0 配置
# 设为 true 启用验证码；设为 false 或留空则关闭
VITE_ALI_CAPTCHA_ENABLED=false
# 验证码场景 ID（阿里云控制台创建）
VITE_ALI_CAPTCHA_SCENE_ID=
# 验证码前缀（阿里云控制台获取，默认 1m0xni）
VITE_ALI_CAPTCHA_PREFIX=1m0xni
