{
  "name": "huizhi-api-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://www.agentsyun.com",
  "scripts": {
    "dev": "rsbuild dev --env-mode dev",
    "build": "rsbuild build --env-mode prod",
    "postbuild": "node scripts/run-react-snap.cjs",
    "build:dev": "rsbuild build --env-mode dev",
    "build:sit": "rsbuild build --env-mode sit",
    "build:prod": "rsbuild build --env-mode prod && node scripts/run-react-snap.cjs",
    "preview": "rsbuild preview",
    "upload:sit": "node scripts/upload-to-oss.cjs --env sit",
    "upload:prod": "node scripts/upload-to-oss.cjs --env prod"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "antd": "^6.3.5",
    "core-js": "^3.49.0",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.4.6",
    "@rsbuild/plugin-react": "^1.3.4",
    "@rsbuild/plugin-sass": "^1.3.3",
    "@rsbuild/plugin-svgr": "^1.2.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "ali-oss": "^6.21.0",
    "autoprefixer": "^10.4.27",
    "react-snap": "^1.23.0",
    "sass": "^1.98.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "reactSnap": {
    "include": [
      "/",
      "/marketing"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": true,
    "crawl": false,
    "source": "dist"
  }
}
