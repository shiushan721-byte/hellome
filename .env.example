# Model routing
# Supported providers: openrouter | openai | gemini | mock
MODEL_PROVIDER="mock"
MODEL_NAME="openai/gpt-4.1-mini"
MODEL_BASE_URL=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Existing image generation relay (optional)
GRSAI_API_KEY=""
GRSAI_BASE_URL="https://grsai.dakka.com.cn"

# Gnomic SSO (leave internal API empty for local mock mode)
GNOMIC_SSO_BASE_URL="https://www.gnomic.cn"
GNOMIC_INTERNAL_API_BASE_URL=""
GNOMIC_INTERNAL_API_KEY=""
GNOMIC_SSO_TICKET_TTL_SECONDS="120"

# Agent云 SSO (Token 工场 /hub/models)
